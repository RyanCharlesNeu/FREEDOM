                .rufus-ingress-badge .a-button-text,
                .rufus-ingress-badge:hover .a-button-text,
                .rufus-ingress-badge:active .a-button-text,
                .rufus-ingress-badge .a-button-base:hover .a-button-text,
                .rufus-ingress-badge .a-button-base:active .a-button-text {
                    color: var(--Color-Alexa-Blue-900, #002D74) !important;
                }
            </style>
