            <span class="a-declarative" data-action="show-rufus-price-ingress" data-show-rufus-price-ingress="{}">     <span class="rufus-ingress-badge">
                            <span class="a-button a-button-base" id="a-autoid-12"><span class="a-button-inner"><input class="a-button-input" type="submit" aria-labelledby="a-autoid-12-announce"><span class="a-button-text" aria-hidden="true" id="a-autoid-12-announce"> Price history </span></span></span> </span>
