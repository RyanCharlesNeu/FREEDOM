f;\n                box-sizing: border-box;\n                width: 100%;\n                height: 100%;\n              }\n            &lt;/style&gt;\n            &lt;title&gt;&lt;/title&gt;\n            \n        &lt;/head&gt;\n        &lt;body&gt;\n            \n            &lt;div id=\&quot;ad\&quot; style=\&quot;width: 100%; height: 100%;\&quot;&gt;&lt;section aria-label=\&quot;Sponsored ad from Seventh Generation\&quot; style=\&quot;height:100%;width:100%\&quot; data-is-ad=\&quot;true\&quot; data-reactroot=\&quot;\&quot;&gt;&lt;div role=\&quot;link\&quot; tabindex=\&quot;0\&quot; class=\&quot;_wrapper_6ktlx_1\&quot;&gt;&lt;style&gt;\n/* ============================================\n   TAILWIND CONVERSION RESET - COMPONENT SCOPED\n   ============================================ */\n\n/* CORE RESET - Box Model &amp;amp; Spacing */\n.tw-reset *,\n.tw-reset *::before,\n.tw-reset *::after {\n  box-sizing: border-box;\n  border-width: 0;\n  border-style: solid;\n  border-color: currentColor;\n}\n\n.tw-reset *::before,\n.tw-reset *::after {\n  --tw-content: &amp;#x27;&amp;#x27;;\n}\n\n.tw-reset * {\n  margin: 0;\n  padding: 0;\n}\n\n/* HTML &amp;amp; BODY Defaults */\n.tw-reset {\n  line-height: 1.5;\n  -webkit-text-size-adjust: 100%;\n  -moz-tab-size: 4;\n  tab-size: 4;\n  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Helvetica Neue&amp;quot;, Arial, &amp;quot;Noto Sans&amp;quot;, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;;\n  font-feature-settings: normal;\n  font-variation-settings: normal;\n}\n\n/* TYPOGRAPHY Resets */\n.tw-reset h1,\n.tw-reset h2,\n.tw-reset h3,\n.tw-reset h4,\n.tw-reset h5,\n.tw-reset h6 {\n  font-size: inherit;\n  font-weight: inherit;\n}\n\n.tw-reset p,\n.tw-reset h1,\n.tw-reset h2,\n.tw-reset h3,\n.tw-reset h4,\n.tw-reset h5,\n.tw-reset h6 {\n  overflow-wrap: break-word;\n}\n\n.tw-reset a {\n  color: inherit;\n  text-decoration: inherit;\n}\n\n.tw-reset b,\n.tw-reset strong {\n  font-weight: bolder;\n}\n\n.tw-reset code,\n.tw-reset kbd,\n.tw-reset samp,\n.tw-reset pre {\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, monospace;\n  font-size: 1em;\n}\n\n.tw-reset small {\n  font-size: 80%;\n}\n\n.tw-reset sub,\n.tw-reset sup {\n  font-size: 75%;\n  line-height: 0;\n  position: relative;\n  vertical-align: baseline;\n}\n\n.tw-reset sub {\n  bottom: -0.25em;\n}\n\n.tw-reset sup {\n  top: -0.5em;\n}\n\n/* LISTS */\n.tw-reset ul,\n.tw-reset ol {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n/* FORM ELEMENTS */\n.tw-reset button,\n.tw-reset input,\n.tw-reset optgroup,\n.tw-reset select,\n.tw-reset textarea {\n  font-family: inherit;\n  font-size: 100%;\n  font-weight: inherit;\n  line-height: inherit;\n  color: inherit;\n  margin: 0;\n  padding: 0;\n}\n\n.tw-reset button,\n.tw-reset select {\n  text-transform: none;\n}\n\n.tw-reset button,\n.tw-reset [type=&amp;#x27;button&amp;#x27;],\n.tw-reset [type=&amp;#x27;reset&amp;#x27;],\n.tw-reset [type=&amp;#x27;submit&amp;#x27;] {\n  -webkit-appearance: button;\n  background-color: transparent;\n  background-image: none;\n}\n\n.tw-reset :-moz-focusring {\n  outline: auto;\n}\n\n.tw-reset :-moz-ui-invalid {\n  box-shadow: none;\n}\n\n.tw-reset progress {\n  vertical-align: baseline;\n}\n\n.tw-reset ::-webkit-inner-spin-button,\n.tw-reset ::-webkit-outer-spin-button {\n  height: auto;\n}\n\n.tw-reset [type=&amp;#x27;search&amp;#x27;] {\n  -webkit-appearance: textfield;\n  outline-offset: -2px;\n}\n\n.tw-reset ::-webkit-search-decoration {\n  -webkit-appearance: none;\n}\n\n.tw-reset ::-webkit-file-upload-button {\n  -webkit-appearance: button;\n  font: inherit;\n}\n\n/* MEDIA ELEMENTS */\n.tw-reset img,\n.tw-reset svg,\n.tw-reset video,\n.tw-reset canvas,\n.tw-reset audio,\n.tw-reset iframe,\n.tw-reset embed,\n.tw-reset object {\n  display: block;\n  vertical-align: middle;\n}\n\n.tw-reset img,\n.tw-reset video {\n  max-width: 100%;\n  height: auto;\n}\n\n/* TABLE ELEMENTS */\n.tw-reset table {\n  text-indent: 0;\n  border-color: inherit;\n  border-collapse: collapse;\n}\n\n/* INTERACTIVE ELEMENTS */\n.tw-reset summary {\n  display: list-item;\n}\n\n/* HIDDEN ATTRIBUTE */\n.tw-reset [hidden] {\n  display: none;\n}\n\n/* TAILWIND-SPECIFIC Defaults */\n.tw-reset {\n  box-sizing: border-box;\n}\n\n.tw-reset button {\n  cursor: pointer;\n}\n\n.tw-reset button:disabled {\n  cursor: default;\n}\n\n.tw-reset hr {\n  height: 0;\n  color: inherit;\n  border-top-width: 1px;\n}\n\n.tw-reset abbr:where([title]) {\n  text-decoration: underline dotted;\n}\n\n.tw-reset * {\n  overflow-wrap: break-word;\n}\n\n/* ADDITIONAL NORMALIZATION */\n.tw-reset *:where(:not(svg, svg *)) {\n  flex-shrink: 1;\n}\n\n.tw-reset {\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n.tw-reset img {\n  max-width: 100%;\n  height: auto;\n}\n\n.tw-reset fieldset {\n  border: 0;\n  padding: 0;\n  margin: 0;\n  min-width: 0;\n}\n\n.tw-reset legend {\n  padding: 0;\n}\n\n.tw-reset textarea {\n  resize: vertical;\n}\n\n.tw-reset ::placeholder {\n  opacity: 1;\n  color: #9ca3af;\n}\n\n.tw-reset ::-webkit-datetime-edit-fields-wrapper {\n  padding: 0;\n}\n\n.tw-reset ::-webkit-date-and-time-value {\n  min-height: 1.5em;\n}\n\n.tw-reset ::-webkit-datetime-edit {\n  display: inline-flex;\n}\n\n.tw-reset ::-webkit-datetime-edit,\n.tw-reset ::-webkit-datetime-edit-year-field,\n.tw-reset ::-webkit-datetime-edit-month-field,\n.tw-reset ::-webkit-datetime-edit-day-field,\n.tw-reset ::-webkit-datetime-edit-hour-field,\n.tw-reset ::-webkit-datetime-edit-minute-field,\n.tw-reset ::-webkit-datetime-edit-second-field,\n.tw-reset ::-webkit-datetime-edit-millisecond-field,\n.tw-reset ::-webkit-datetime-edit-meridiem-field {\n  padding-top: 0;\n  padding-bottom: